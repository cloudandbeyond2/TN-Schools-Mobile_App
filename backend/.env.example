# TN Schools backend environment variables
# Copy to .env and fill in real values.

PORT=5000
NODE_ENV=development

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/tnschools"

# MongoDB (Mongoose)
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/tnschools"

# Shared JWT secret (must match the frontend's NEXTAUTH_SECRET)
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Gemini API key — fallback when no key is configured in the superadmin
# AI Integration Setup page (which takes precedence).
GEMINI_API_KEY=""

# AES-256-GCM key for encrypting integration secrets (storage/AI credentials)
# stored in MongoDB. 64-char hex (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: rotating this key invalidates all stored secrets — they must be
# re-entered in the superadmin Storage / AI Integration pages afterwards.
CONFIG_ENCRYPTION_KEY=""
