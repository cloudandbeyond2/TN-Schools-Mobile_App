// PET portal — student fitness record (body measurements, fitness
// assessment, physical activity and health indicators). Kept independent of
// SportsProfile: PET staff also track students without a linked Student row
// (manual entries), so studentId is optional.
model PetFitnessRecord {
  id                String   @id @default(uuid())
  schoolId          String?
  studentId         String?
  name              String
  class             String   @default("")
  sport             String   @default("")
  status            String   @default("")
  heightCm          Float    @default(0)
  weightKg          Float    @default(0)
  endurance         Int      @default(70)
  strength          Int      @default(70)
  flexibility       Int      @default(70)
  speed             Int      @default(70)
  lastAssessed      String   @default("")
  activityLevel     String   @default("Moderate")
  weeklyActivityHrs Float    @default(5)
  restingHeartRate  Int      @default(0)
  bloodGroup        String   @default("")
  vision            String   @default("Normal")
  lastCheckup       String   @default("")
  healthNotes       String   @default("")
