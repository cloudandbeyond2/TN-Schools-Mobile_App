// ─── Premium Mock Tests Management ─────────────────────────────────────────────
model MockTest {
  id            String   @id @default(uuid())
  title         String
  description   String?
  grade         String
  subject       String
  duration      Int      @default(60) // minutes
  totalMarks    Int      @default(100)
  status        String   @default("DRAFT") // DRAFT, PUBLISHED
  createdByRole String   // SUPER_ADMIN, HEADMASTER, TEACHER
  createdById   String
  schoolId      String?  // null if created by Super Admin (state-wide)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions     MockTestQuestion[]
  assignments   MockTestAssignment[]
}

model MockTestQuestion {
  id          String   @id @default(uuid())
  mockTestId  String
  mockTest    MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  type        String   // mcq, short
  text        String
  options     String[]
  answer      String
  marks       Int
  order       Int      @default(0)
}

model MockTestAssignment {
  id          String   @id @default(uuid())
  mockTestId  String
  mockTest    MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  schoolId    String?  // If assigned to a specific school
  class       String?
  section     String?
  assignedAt  DateTime @default(now())
  dueDate     DateTime?

  submissions MockTestSubmission[]
}

model MockTestSubmission {
  id           String   @id @default(uuid())
  assignmentId String
  assignment   MockTestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers      Json     // Student's answers
  score        Float?
  status       String   @default("PENDING") // PENDING, GRADED
  submittedAt  DateTime @default(now())
}

model InfographicLesson {
  id              String   @id @default(uuid())
  class           String
  subjectId       String
  topic           String
  focus           String
  infographicData Json
  teacherId       String?
  isPublished     Boolean  @default(false)
  publishedSections String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([subjectId])
  @@index([teacherId])
}

/// AI Content Studio library — every generation a teacher chooses to keep.
/// payload shape is determined by outputKind (see backend/src/constants/aiSkills.ts).
model AiContent {
  id          String    @id @default(uuid())
  schoolId    String?
  teacherId   String?
  classRoomId String?
  skillKey    String
  outputKind  String
  subjectPack String
  subject     String
  className   String
  section     String?
  unit        String?
  topic       String
  title       String
  language    String    @default("english")
  payload     Json
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId])
  @@index([teacherId])
  @@index([skillKey])
  @@index([isPublished])
  @@index([className])
}

