  result            PromotionResult?
  attendancePct     Float?
  daysPresent       Int?
  totalWorkingDays  Int?
  averageMarksPct   Float?
  marksSummary      Json?
  promotionRecordId String?
  createdAt         DateTime         @default(now())

  @@unique([studentId, academicYear])
  @@index([schoolId, academicYear])
}

// ─── Science Labs & Centers Module Models ───

model ScienceBook {
  id            String           @id @default(uuid())
  bookName      String
  grade         String
  medium        String
  volume        String
  pdfUrl        String
  coverImageUrl String
  year          String           @default("2024")
  chapters      ScienceChapter[]
  createdAt     DateTime         @default(now())
}

model ScienceChapter {
  id              String           @id @default(uuid())
  bookId          String
  chapterNumber   Int
  title           String
  summary         String           @db.Text
  importantPoints String[]
  mindMapData     Json
  flowchartData   Json
  vocabulary      Json
  formulaSheet    Json?
  assets3d        String[]
  createdAt       DateTime         @default(now())
  book            ScienceBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  assignments     LabAssignment[]
  readingProgress ReadingTracker[]
}

model VirtualLab {
  id          String          @id @default(uuid())
  name        String
  icon        String
  description String
  experiments LabExperiment[]
}

model LabExperiment {
  id               String                     @id @default(uuid())
  labId            String
  title            String
  grade            String
  medium           String
  difficulty       String
  materialsNeeded  String[]
  safetyGuide      String[]
  steps            Json
  simulationConfig Json
  videoUrl         String?
  narrationUrls    Json
  createdAt        DateTime                   @default(now())
  lab              VirtualLab                 @relation(fields: [labId], references: [id], onDelete: Cascade)
  attempts         StudentExperimentAttempt[]
}

model StudentExperimentAttempt {
  id           String        @id @default(uuid())
  studentId    String
  experimentId String
  timeSpentSec Int
  completed    Boolean       @default(false)
  score        Int?
  findings     String?
  createdAt    DateTime      @default(now())
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  experiment   LabExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
}

model ReadingTracker {
  id           String         @id @default(uuid())
  studentId    String
  chapterId    String
  pagesRead    Int
  timeSpentSec Int
  completed    Boolean        @default(false)
  updatedAt    DateTime       @updatedAt
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  chapter      ScienceChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model ScienceProject {
  id          String              @id @default(uuid())
  title       String
  grade       String
  topic       String
  difficulty  String
  materials   String[]
  steps       Json
  rubric      Json
  createdAt   DateTime            @default(now())
  submissions ProjectSubmission[]
}

model ProjectSubmission {
  id            String         @id @default(uuid())
  projectId     String
  studentId     String
  submissionUrl String
  marksScored   Int?
  feedback      String?
  gradedBy      String?
  createdAt     DateTime       @default(now())
  project       ScienceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model LabAssignment {
  id          String         @id @default(uuid())
  chapterId   String
  teacherId   String
  classRoomId String
  dueDate     DateTime
  createdAt   DateTime       @default(now())
  chapter     ScienceChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model ProxyAssignment {
  id              String   @id @default(uuid())
  schoolId        String
  date            DateTime
  period          Int
  timetableId     String
  absentTeacherId String
  proxyTeacherId  String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date, period, timetableId])
}

// ─── School Exam Schedule (HM side — school-level only) ──────────────
model ExamSchedule {
  id                String   @id @default(uuid())
  schoolId          String
  title             String // e.g. "Term 1 Exam 2024-25"
  examType          String // Monthly | Quarterly | Half-Yearly | Annual | Unit Test
  class             String // e.g. "6", "10", "12"
  section           String   @default("All") // "A", "B", or "All" for whole class
  subject           String // e.g. "Mathematics"
  examDate          DateTime
  startTime         String // "09:00"
  endTime           String // "12:00"
  maxMarks          Int      @default(100)
  passMark          Int      @default(35)
  venue             String?  @default("Classroom")
  invigilator       String? // Teacher name
  academicYear      String   @default("2024-25")
  status            String   @default("Scheduled") // Scheduled | Completed | Postponed | Cancelled
  notes             String?
  examMode          String   @default("Theory") // Theory | Practical | Both
  theoryMaxMarks    Int      @default(100)
  practicalMaxMarks Int      @default(0)
  published         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, class, examType])
  @@index([schoolId, examDate])
  @@index([schoolId, academicYear])
}

// ── Model Exam Results System (Classes 6-10, Samacheer Kalvi) ─────────────

model ModelExam {
  id           String            @id @default(uuid())
  schoolId     String
  examName     String // e.g. "Unit Test 1", "Half Yearly"
  examType     String            @default("Unit Test") // Unit Test | Half Yearly | Model | Annual
  class        String // "6","7","8","9","10","11","12"
  section      String            @default("A")
  group        String? // optional for 11th & 12th (e.g. "Biology", "Computer Science", "Commerce")
  academicYear String            @default("2024-25")
  examDate     DateTime?
  isLocked     Boolean           @default(false)
  lockedAt     DateTime?
  createdBy    String? // userId of headmaster
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  results      ModelExamResult[]

  @@index([schoolId])
  @@index([schoolId, class])
  @@index([schoolId, academicYear])
}

model ModelExamResult {
  id               String    @id @default(uuid())
  examId           String
  exam             ModelExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId        String
  studentName      String
  rollNumber       String
  // Samacheer Kalvi core subjects (max 100 each)
  tamil            Int?
  english          Int?
  mathematics      Int?
  science          Int?
  socialScience    Int?
  extraSubject     Int? // Optional 6th subject (Language / Computer)
  extraSubjectName String? // Name of extra subject
  total            Int? // Sum of all entered subjects
  maxTotal         Int       @default(500) // 5×100 or 6×100
  percentage       Float?
  grade            String? // A+, A, B+, B, C, D, U
  isPassed         Boolean?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

model StudySchedule {
  id           String   @id @default(uuid())
  studentId    String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  scheduleData Json
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model AcademicClass {
  id        String   @id @default(uuid())
  name      String   @unique
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicSection {
  id        String   @id @default(uuid())
  name      String   @unique
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicSubject {
  id          String             @id @default(uuid())
  name        String
  color       String?
  icon        String?
  class       String?
  section     String?
  subjectCode String?
  medium      String?
  description String?
  schoolId    String?
  board       String?            @default("State Board")
  status      String             @default("Active")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  resources   AcademicResource[]

  @@index([schoolId])
}

model AcademicResource {
  id               String   @id @default(uuid())
  title            String
  subjectId        String
  category         String // syllabus, textbooks, materials, notes, videos, digital, reference
  type             String // PDF, DOC, Video, Audio, Interactive, eBook, Link
  url              String?
  meta             String? // size / pages / duration
  description      String?
  addedBy          String?
  isNew            Boolean  @default(false)
  popular          Boolean  @default(false)
  class            String?
  section          String?
  schoolId         String?
  board            String?  @default("State Board")
  group            String?
  term             String?
  chapterNumber    String?
  topicName        String?
  learningOutcomes String?
  medium           String?
  bookVersion      String?
  publisher        String?
  language         String?
  coverImage       String?
  materialType     String?
  downloadAllowed  Boolean? @default(true)
  chapter          String?
  lessonTitle      String?
  youtubeUrl       String?
  videoDuration    String?
  thumbnail        String?
  contentType      String?
  author           String?
  isbn             String?
  status           String   @default("Active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subject AcademicSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([category])
  @@index([schoolId])
}

